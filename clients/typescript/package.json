{
    "name": "@sendaifun/async-vault-client",
    "version": "0.1.0-devnet.1",
    "description": "Generated TypeScript client for the SendAI Async Vault program",
    "license": "MIT",
    "sideEffects": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sendaifun/vault.git",
        "directory": "clients/typescript"
    },
    "type": "module",
    "source": "./src/index.ts",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "tag": "devnet"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "pnpm clean && tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --format=esm --platform=neutral --packages=external --outfile=dist/index.js",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "generate": "pnpm --dir ../.. generate-ts-client",
        "prepack": "pnpm generate && pnpm typecheck && pnpm build",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "solana",
        "solana-kit",
        "vault",
        "async-vault"
    ],
    "homepage": "https://github.com/sendaifun/vault#readme",
    "bugs": {
        "url": "https://github.com/sendaifun/vault/issues"
    },
    "devDependencies": {
        "@solana/kit": "6.9.0",
        "esbuild": "0.28.1"
    },
    "peerDependencies": {
        "@solana/kit": "^6.9.0"
    }
}
